# Node's built-in --env-file, wired into `npm start` and `npm run dev`. No
# dotenv dependency: it is one flag in Node 20.6+ and one fewer package to audit
# for something that only ever holds one file.
#
# The bot has exactly one job: mirror "who holds a staff role" into the
# `staff` table. It approves nothing. See database/migrations/011_staff_from_discord_roles.sql.

# From the Developer Portal -> Bot -> Token. Reset it if it was ever exposed.
DISCORD_BOT_TOKEN=

# Server Settings -> your server -> enable Developer Mode, right-click the
# server name, Copy Server ID.
DISCORD_GUILD_ID=

# Right-click the staff role -> Copy Role ID. Several roles may be listed,
# comma-separated: 111111111111111111,222222222222222222
#
# IF THIS IS WRONG THE BOT REFUSES TO START. An empty or misspelled role ID
# would otherwise sync an empty table and lock every moderator out of /admin
# while looking perfectly healthy.
DISCORD_STAFF_ROLE_IDS=

# The role Discord created for the bot on invite. Server Settings -> Roles, or
# right-click your bot -> Copy Role ID.
#
# Recorded for ONE reason that is not tidiness: a bot's own role sits at the TOP
# of the role hierarchy, so it can hand itself any role below it. If this id ever
# appeared in DISCORD_STAFF_ROLE_IDS, the bot would mirror ITSELF into the staff
# table — and a bot that can appoint itself moderator is worse than no admin area
# at all. Listing both makes the bot refuse to start instead.
DISCORD_BOT_ROLE_ID=

# Database. Use the GAME account (nifty), not a website account: the bot needs
# INSERT/UPDATE/DELETE on `staff`, and the website accounts deliberately have
# none of those. Values are in database/.credentials.local under [game].
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=nifty_life

# Safety-net resync in milliseconds. Events handle promotions and removals
# immediately; this is the backstop for events missed while the bot was down.
# Minimum 60000.
STAFF_RESYNC_MS=900000

# Where the team area lives. The site navigation deliberately does NOT link to
# it, so this address is what you put in a pinned Discord message. The bot
# prints it on every startup.
WEB_ADMIN_URL=http://localhost:3000/admin

# ---- Transcriber (bot/transcriber/service.py) ----
#
# The service runs in its own process and keeps the faster-whisper model warm.
# A model load costs seconds, so spawning one per transcription would pay that
# every single time.
#
# TRANSCRIBER_TOKEN: THE SERVICE REFUSES TO START WITHOUT IT. It is not
# protecting the network - it binds to loopback - it is stopping any other
# process on this account from naming a file for it to read. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRANSCRIBER_TOKEN=
TRANSCRIBER_HOST=127.0.0.1
TRANSCRIBER_PORT=8731

# `turbo` is large-v3-turbo: close to large-v3 quality, far cheaper. `small` is
# the fast one for smoke tests. Weights download on first use.
TRANSCRIBER_MODEL=turbo

# int8 on CPU. float16 needs a GPU, which this machine does not use for this.
TRANSCRIBER_COMPUTE_TYPE=int8
TRANSCRIBER_LOG_LEVEL=INFO