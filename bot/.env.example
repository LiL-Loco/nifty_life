# Bot configuration — COPY to bot/.env and fill in. Never commit .env.
#
# The bot has exactly one job: mirror "who holds a staff role" into the
# `staff` table. It approves nothing. See database/migrations/011_staff_from_discord_roles.sql.

# From the Developer Portal -> Bot -> Token. Reset it if it was ever exposed.
DISCORD_BOT_TOKEN=

# Server Settings -> your server -> enable Developer Mode, right-click the
# server name, Copy Server ID.
DISCORD_GUILD_ID=

# Right-click the staff role -> Copy Role ID. Several roles may be listed,
# comma-separated: 111111111111111111,222222222222222222
#
# IF THIS IS WRONG THE BOT REFUSES TO START. An empty or misspelled role ID
# would otherwise sync an empty table and lock every moderator out of /admin
# while looking perfectly healthy.
DISCORD_STAFF_ROLE_IDS=

# Database. Use the GAME account (nifty), not a website account: the bot needs
# INSERT/UPDATE/DELETE on `staff`, and the website accounts deliberately have
# none of those. Values are in database/.credentials.local under [game].
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=nifty_life

# Safety-net resync in milliseconds. Events handle promotions and removals
# immediately; this is the backstop for events missed while the bot was down.
# Minimum 60000.
STAFF_RESYNC_MS=900000