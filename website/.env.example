# Nifty Life 2.0 - website configuration
#
# Copy to `website/.env` and fill in. `.env` is git-ignored; never commit it.
#
# The database user MUST be `nifty_website`, NOT the game server's account.
# Its grant set is the privilege boundary from ADR-0007 and ADR-0022: it may
# INSERT an application and read it back, and it may never UPDATE anything.
# Pointing this at a privileged account silently removes that boundary without
# changing a single line of application code.

# ---- Database --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nifty_website
DB_PASSWORD=CHANGE_ME_WEB
DB_NAME=nifty_life

# ---- Sessions ---------------------------------------------------------------
# 32+ random bytes. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME

# ---- Discord OAuth (https://discord.com/developers/applications) ------------
#
# Discord is NOT the login. Signing in is email + password, done on /login, and
# Discord is ATTACHED to an existing account on /account. Attaching is what an
# application needs, because the game server gates on `accounts.discord_id` and
# that is the only identity it knows.
#
# Scope: `identify` ONLY, and it is requested in code (src/lib/discord.ts), not
# by the portal's URL generator. `email`, `guilds` and `openid` would each add a
# personal identifier this site has no use for.
#
# Redirects (OAuth2 -> Redirects in the portal): register EXACTLY this string.
# Discord compares it character for character, so the port has to match the port
# the site is actually served on - `localhost:3000` is the Next.js default, and
# running on anything else needs its own registered entry. This is the same
# callback the site used for login; only what it does afterwards changed.
#
# The `bot` scope belongs to the separate staff bot (ADR-0007), not to this
# attach flow. Invite it with the fewest permissions that work.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback
# ---- Portal accounts (email + password) -------------------------------------
# Base URL used for links that are followed OUTSIDE a request — above all the
# confirmation mail, which is read in a mail client. Never derive it from
# x-forwarded-host: that header is attacker-controlled and would put a
# confirmation link on somebody else's domain.
PUBLIC_URL=http://localhost:3000

# SMTP, for the address-confirmation link. With none of these set, the site
# still starts and every other page works — but `sendMail` REFUSES and the
# registration form says so, rather than accepting an account whose
# confirmation is quietly going nowhere. There is no in-memory fallback by
# design: a queue that nobody reads is not a queue.
#
# nodemailer, MIT and free. Host 587 + STARTTLS is what every mainstream provider
# offers; set SMTP_SECURE=true for an implicit-TLS port such as 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=

# Public Discord invite, used only by the landing page's first button. Leave it
# empty and the button renders disabled with "Einladung folgt" rather than
# pointing at nothing — a dead JOIN DISCORD is the first thing anybody notices.
DISCORD_INVITE_URL=
