# Local database credentials — TEMPLATE.
#
# Copy to `database/.credentials.local` and fill in. That file is git-ignored;
# this one is not, so it must never contain a real password.
#
# These accounts are created by `database/grants.sql`. `website/tools/verify-boundary.ps1`
# reads the real values from the local copy and proves the website cannot
# approve an application, confirm its own pairing request, or touch player data.

[game]
# server.cfg -> mysql_connection_string
# Needs full access: it owns sessions, characters, the ledger and moderation.
user=nifty
host=127.0.0.1
password=

[website]
# website/.env
# Restricted on purpose. No UPDATE anywhere, no SELECT on wallets/characters,
# and no access at all to web_pairing_codes. If you ever point the website at
# the `game` account, that boundary is gone without a single line changing.
user=nifty_website
host=localhost
password=