# Nifty Life 2.0 — server configuration template
# Copy to server.cfg and fill in. NEVER commit server.cfg (it is git-ignored).

# ---- Identity -------------------------------------------------------------
sv_hostname "Nifty Life 2.0"

# Keys live on the Cfx Portal. Not in this repo, not in any commit.
sv_authMaxVariance 1.0
sv_authMinTrust 0.0

# `sv_projectName`, `sv_projectDesc` and `sv_pure_verify_client_settings` are
# NOT set here on purpose. They are declared by the Cfx Portal for a keyed
# server; without keys they do not exist and FXServer logs
# "Command not found (sv_projectname)" for each one on every start. Add them
# back once a key set exists — not before.

# ---- Database (ADR-0005) --------------------------------------------------
# Local MariaDB. The password belongs here and nowhere else.
set mysql_connection_string "mysql://nifty:CHANGE_ME@127.0.0.1:3306/nifty_life?charset=utf8mb4"

# ---- OneSync --------------------------------------------------------------
onesync on

# Entity lockdown: ADR-0004 keeps server-owned vehicles alive across restarts.
# `relaxed` is deliberate — full mode disables dummy objects, which is a bigger
# behavioural change than this server needs on Legacy.
sv_entityLockdown "relaxed"

# ---- Client hardening (default-on in FXServer 8450+, listed for auditability)
set sv_kick_players_cnl_timeout_sec 60
set sv_kick_players_cnl_update_rate_sec 300
set sv_kick_players_cnl_consecutive_failures 2
set sv_filterRequestControl 1
set sv_disableClientReplays 1

# ---- Weekend window (ADR-0010) -------------------------------------------
# Fri 19:00 → Sun 22:00, one restart. Connections refused outside the window;
# the enforce function lands with layer 3.
# sessions_per_hour is irrelevant at our size; setsv_maxClients caps the join.
sets sv_maxClients 48

# ---- Resources ------------------------------------------------------------
# Everything below `ensure` must be present in `resources/` before the server
# starts. They are EXTERNAL dependencies: download them, do not vendor them.
# `resources/oxmysql/`, `resources/bob74_ipl-*/` and `resources/[map]/` are
# git-ignored for exactly that reason — committing someone else's repository
# into this one's history ties us to their release cadence and buries our own
# diff.
ensure oxmysql
ensure Bob74_IPL           # ADR-0016 — downloaded per release, never committed
ensure mapmanager
ensure spawnmanager
ensure chat

# NO sessionmanager. ADR-0002 rolls our own sessions in `server/identity.lua`,
# and ensuring a resource that is not present fails the boot with
# `Resource "sessionmanager" not found`. If you ever add it back, delete this
# comment with it.

ensure [nifty]

# ---- Groups (reorder as groups are added) ---------------------------------
# start [nifty]
# stop  [nifty]