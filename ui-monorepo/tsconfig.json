{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@nifty/ui": ["packages/ui/src/index.ts"],
      "@nifty/ui/*": ["packages/ui/src/*"],
      "@nifty/bridge": ["packages/bridge/src/index.ts"]
    }
  },
  "include": ["packages/*/src"]
}
