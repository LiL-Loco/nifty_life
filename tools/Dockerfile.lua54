# Lua 5.4 toolchain for the headless harness.
#
# This lives as a FILE rather than being piped into `docker build -f -` from the
# PowerShell script. That matters: a Dockerfile arriving on stdin gets a fresh
# cache key every run, so each invocation re-downloads and re-creates layers and
# leaves them behind as build cache. That accumulated to 20 GB before it was
# noticed, and a full Docker VM silently turned every migration into
# `ERROR 121 - Duplicate key on write or update`, which looks exactly like a
# broken SQL file and is not one at all.
FROM mariadb:11

RUN apt-get update -qq \
 && apt-get install -y -qq lua5.4 \
 && rm -rf /var/lib/apt/lists/*